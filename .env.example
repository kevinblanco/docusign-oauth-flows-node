# Docusign OAuth, three ways
# Copy this file to .env and fill it in. Never commit .env or private.key.

# ── App 1, confidential: answers Yes, it can store a client secret ─────────
# Used by JWT Grant and the Confidential Authorization Code Grant.
# The integration key is the app's Client ID in the Developer Console.
DOCUSIGN_INTEGRATION_KEY=
# A secret key added to App 1. Docusign shows it once: copy it then.
DOCUSIGN_SECRET_KEY=
# JWT Grant: the user the token acts as. Your user ID is on the Apps and Keys
# page, and the app shows it as userinfo's sub after a Confidential ACG sign-in.
DOCUSIGN_USER_ID=
# JWT Grant: the RSA private key generated for App 1, saved to this file.
# Docusign shows it once. The file is gitignored.
DOCUSIGN_PRIVATE_KEY_PATH=private.key

# ── App 2, public: answers No, it can't store a client secret ──────────────
# Used by the Public Authorization Code Grant with PKCE. Its Client ID goes here.
DOCUSIGN_PUBLIC_INTEGRATION_KEY=

# ── Where things run ───────────────────────────────────────────────────────
# Developer accounts authenticate here. Production uses https://account.docusign.com.
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com
# The redirect URIs are built from this: /jwt/consent, /acg/callback, /pkce/callback.
APP_URL=http://localhost:3000

# IDs and tokens are masked on the page, for screen recordings. false shows them whole.
# Secret keys never appear either way.
# MASK_IDS=true
